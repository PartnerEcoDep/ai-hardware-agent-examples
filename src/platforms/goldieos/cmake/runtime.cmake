include_guard(GLOBAL)
# Extract the pinned vendor payload into this build, never into the source tree.
get_filename_component(_runtime_root "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
include("${_runtime_root}/third_party/goldieos/checksums.cmake")
set(_archive "${_runtime_root}/third_party/goldieos/runtime.tar.gz")
file(SIZE "${_archive}" _archive_bytes)
if(_archive_bytes GREATER 50000000)
    message(FATAL_ERROR "GoldieOS runtime archive exceeds 50 MB (50000000 bytes)")
endif()
file(SHA256 "${_archive}" _actual)
if(NOT _actual STREQUAL GOLDIEOS_RUNTIME_SHA256)
    message(FATAL_ERROR "GoldieOS runtime archive checksum mismatch")
endif()
set(GOLDIEOS_ROOT "${CMAKE_BINARY_DIR}/deps/goldieos-${GOLDIEOS_RUNTIME_SHA256}")
if(NOT EXISTS "${GOLDIEOS_ROOT}/.complete")
    file(MAKE_DIRECTORY "${GOLDIEOS_ROOT}")
    file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${GOLDIEOS_ROOT}")
    file(WRITE "${GOLDIEOS_ROOT}/.complete" "${GOLDIEOS_RUNTIME_SHA256}")
endif()
unset(_runtime_root)
unset(_archive)
unset(_archive_bytes)
unset(_actual)
