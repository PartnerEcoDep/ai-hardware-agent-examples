function(goldieos_component_config target)
    if(EXISTS "${WS63_LOCAL_CONFIG}")
        configure_file("${WS63_LOCAL_CONFIG}" "${CMAKE_CURRENT_BINARY_DIR}/ws63_config.h" COPYONLY)
    else()
        configure_file("${app_root}/config/ws63.local.h.example" "${CMAKE_CURRENT_BINARY_DIR}/ws63_config.h" COPYONLY)
        message(STATUS "Cloud credentials not configured; AI start will report error -7")
    endif()
    target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/config.c")
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
endfunction()
